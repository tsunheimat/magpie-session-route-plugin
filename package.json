{
  "name": "magpie-session-routing",
  "version": "0.3.3",
  "description": "Read-only, session-isolated routing observability for Magpie WebUI",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "lib/",
    "page/",
    "ui/index.html",
    "ui/app.js",
    "ui/bridge.js",
    "ui/style.css",
    "ui/vendor/magpie/client.js",
    "ui/vendor/magpie/native-helpers.js",
    "ui/vendor/magpie/app.css",
    "ui/vendor/magpie/routing.css",
    "ui/vendor/magpie/icons/",
    "ui/vendor/magpie/LICENSE",
    "ui/vendor/magpie/THIRD_PARTY_NOTICES",
    "ui/vendor/magpie/LOBE_ICONS_LICENSE",
    "ui/vendor/magpie/static-manifest.json",
    "ui/vendor/magpie/source-manifest.json",
    "ui/vendor/magpie/extraction-manifest.json",
    "ui/vendor/magpie/source-grouping-patch.json",
    "README.md",
    "docs/compatibility.md",
    "docs/validation.md",
    "docs/native-copy-provenance.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test test/browser/*.test.mjs",
    "test:magpie": "node test/magpie/run.mjs",
    "check": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.2",
    "magpie": ">=0.1.3124"
  },
  "magpie": {
    "name": "Session Routing",
    "page": {
      "title": "Session Routing",
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3496,
        "option": "port"
      }
    },
    "options": {
      "port": 3496,
      "showFolders": false,
      "showProjectNames": true
    }
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
